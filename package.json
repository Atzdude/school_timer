{
  "name": "timer",
  "version": "1.3.0",
  "description": "Desktop exam timer application.",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:win:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.naisula.examtimer",
    "productName": "timer",
    "executableName": "timer",
    "asar": true,
    "files": [
      "main.js",
      "timer_fixed_v2.html",
      "naisula_logo.jpg",
      "build/icon.ico",
      "package.json",
      "fonts/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
